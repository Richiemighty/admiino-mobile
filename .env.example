# Copy to .env.local for local development.
EXPO_PUBLIC_APP_ENV=development

# Local backend origin from admiino-backend/src/config/publicUrls.js.
# Leave blank to run the setup screen without enabling backend connectivity.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_REQUIRED=false

# Add these non-secret identifiers only after the app owner approves them.
# EXPO_IOS_BUNDLE_IDENTIFIER=
# EXPO_ANDROID_PACKAGE_IDENTIFIER=
