{
  "name": "admiino-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.29",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "lucide-react-native": "^1.78.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^29.7.0",
    "jest-expo": "58.0.6",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint '**/*.{ts,tsx,js,mjs}' -- --no-error-on-unmatched-pattern --no-warn-ignored",
    "typecheck": "tsc --noEmit",
    "validate:environment": "node --env-file-if-exists=.env.local --import=tsx scripts/validate-environment.mjs",
    "test:environment": "tsx --test scripts/validate-environment.test.mjs",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,json,yml,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,tsx,json,yml,md}\""
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/scripts/"
    ],
    "testMatch": [
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "clearMocks": true
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/jest",
        "jest",
        "jest-expo"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-masked-view/masked-view",
          "expo-modules-core"
        ]
      }
    }
  },
  "private": true
}
